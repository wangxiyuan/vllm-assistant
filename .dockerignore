# ============================================================================
# vLLM Assistant — .dockerignore
# 减少 Docker 构建上下文大小，加快构建速度
# ============================================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# 虚拟环境
.venv/
venv/
ENV/
env/

# IDE
.idea/
.vscode/
*.swp
*.swo

# 敏感配置（.env 不会打入镜像，而是通过 docker-compose 运行时注入）
.env
.env.example

# 本地数据（运行时通过 volume 挂载）
data/

# 测试
.pytest_cache/
.coverage
htmlcov/

# 日志
*.log

# OS
.DS_Store
Thumbs.db

# 文档
docs/
README.md

# 代码图谱 / Claude 配置（仅开发用）
.codegraph
.claude

# 启动脚本（容器内用 Dockerfile CMD 启动）
start.sh

# 版本控制
.git
.gitignore