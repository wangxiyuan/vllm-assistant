# vLLM Assistant 环境变量配置示例
# 复制此文件为 .env 并填写实际值

# ==================== GitHub 配置 ====================

# GitHub Personal Access Token (必需)
# 用于访问 GitHub API，需要 repo 权限
VLLM_ASSISTANT_PAT=github_pat_your_token_here

# ==================== AI 助手配置 ====================

# OpenAI API Key (可选，用于 AI 辅助功能)
# 用于生成 Review 意见、分析影响范围等
OPENAI_API_KEY=sk-your-api-key

# OpenAI API Base URL (可选，默认: https://api.openai.com/v1)
# 如果使用国内代理或其他服务，修改此地址
OPENAI_BASE_URL=https://maas-coding-api.cn-huabei-1.xf-yun.com/v2

# OpenAI 模型名称 (可选，默认: gpt-4o)
OPENAI_MODEL=astron-code-latest

# LLM 最大 token 数 (可选，默认: 65536)
# 控制 AI 对话的单次最大输出长度
LLM_MAX_TOKENS=65536

# ==================== 服务器配置 ====================

# 监听地址 (可选，默认: 0.0.0.0)
HOST=0.0.0.0

# 监听端口 (可选，默认: 8000)
PORT=8000   

# API 密钥 (可选，用于接口鉴权)
API_KEY=

# 调试模式 (可选，默认: false)
# 设为 1、true 或 yes 可开启
DEBUG=

# ==================== 数据清理配置 ====================

# 社区数据保留天数（可选，默认: 90）
# closed/merged 的 issue/PR 超过此天数将被自动清理
DATA_RETENTION_DAYS=90

# AI 缓存保留条数上限（可选，默认: 1000）
# 超过此数量时删除最旧的缓存记录
AI_CACHE_MAX_RECORDS=1000

# 数据清理间隔（小时）(可选，默认: 24)
CLEANUP_INTERVAL=24

# ==================== 调度器配置 ====================

# 数据轮询间隔（分钟）(可选，默认: 10)
POLLING_INTERVAL=10

# GitHub 同步开关 (可选，默认: true)
# 设为 false 可禁用所有 GitHub API 定时拉取，节省 API 配额（本地调试时推荐）
GITHUB_SYNC_ENABLED=true

# ==================== Personal TODO 配置 ====================

# 洞察报告异步超时（秒）(可选，默认: 180)
INTELLIGENCE_REPORT_TIMEOUT=180

# ==================== Web 搜索配置 ====================

# Tavily 兼容 Web Search API 地址（可选，默认使用公益服务，无需 API Key）
# 默认使用 https://tavily.claude-code-best.win（公益服务，不限制调用量）
# 如果使用官方 Tavily，改为 https://api.tavily.com 并设置 TAVILY_API_KEY
TAVILY_API_URL=https://tavily.claude-code-best.win

# Tavily API Key（可选，官方 Tavily 需要此配置）
# 默认公益服务不需要此配置
TAVILY_API_KEY=

# ==================== Slack 采集配置 ====================

# Slack xoxc token 和 xoxd cookie（可选，从浏览器 DevTools 获取）
# 两个都需要配置，否则 Slack 消息采集功能不可用。
#
# 获取方式：
#   1. 在浏览器中打开 https://<workspace>.slack.com 并登录
#   2. 按 F12 打开开发者工具
#
#   获取 xoxc token：
#     - 切换到 Console 标签，粘贴以下代码后回车：
#       JSON.parse(localStorage.localConfig_v2).teams[document.location.pathname.match(/^\/client\/([A-Z0-9]+)/)[1]].token
#     - 复制输出的 xoxc- 开头的值
#
#   获取 xoxd cookie：
#     - 切换到 Application（Chrome）或 Storage（Firefox）标签
#     - 展开左侧 Cookies，选择 slack.com
#     - 找到名为 d 的 cookie，复制其 Value 列的值
#
# 注意：xoxc token 和 xoxd cookie 会过期，过期后需重新获取
SLACK_TOKEN=xoxc-your-token
SLACK_COOKIE=your-xoxd-cookie-value

# slackdump 凭证文件路径（可选，Docker 部署时使用）
# 通过 slackdump workspace new 在服务器上生成
SLACKDUMP_CRED_FILE=/app/data/slack_cred.json