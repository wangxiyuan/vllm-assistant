# vLLM Assistant 环境变量配置示例
# 复制此文件为 .env 并填写实际值

# ==================== GitHub 配置 ====================

# GitHub Personal Access Token (必需)
# 用于访问 GitHub API，需要 repo 权限
VLLM_ASSISTANT_PAT=ghp_your_token_here

# GitHub 用户名 (可选，用于 PR 指挥中心功能)
# 用于获取指定用户的 PR 列表
GITHUB_USERNAME=your_github_username

# GitHub 仓库所有者 (可选，默认: vllm-project)
GITHUB_OWNER=vllm-project

# GitHub 仓库名称 (可选，默认: vllm)
GITHUB_REPO=vllm

# ==================== AI 助手配置 ====================

# OpenAI API Key (可选，用于 AI 辅助功能)
# 用于生成 Review 意见、分析影响范围等
OPENAI_API_KEY=sk-your-api-key

# OpenAI API Base URL (可选，默认: https://api.openai.com/v1)
# 如果使用国内代理或其他服务，修改此地址
OPENAI_BASE_URL=https://api.openai.com/v1

# OpenAI 模型名称 (可选，默认: gpt-4o)
OPENAI_MODEL=gpt-4o

# ==================== 服务器配置 ====================

# 监听地址 (可选，默认: 0.0.0.0)
HOST=0.0.0.0

# 监听端口 (可选，默认: 8000)
PORT=8000

# ==================== 调度器配置 ====================

# 数据轮询间隔（分钟）(可选，默认: 10)
POLLING_INTERVAL=10

# 仅同步指定领域（逗号分隔，留空 = 全部）
# 例：POLLING_AREAS=engine,hardware
POLLING_AREAS=
