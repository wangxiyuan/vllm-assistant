# vLLM Assistant 环境变量配置示例
# 复制此文件为 .env 并填写实际值

# ==================== GitHub 配置 ====================

# GitHub Personal Access Token (必需)
# 用于访问 GitHub API，需要 repo 权限
VLLM_ASSISTANT_PAT=github_pat_your_token_here

# GitHub 仓库所有者 (可选，默认: vllm-project)
GITHUB_OWNER=vllm-project

# GitHub 仓库名称 (可选，默认: vllm)
GITHUB_REPO=vllm

# ==================== 代码仓库配置 ====================

# 代码仓库列表（逗号分隔，格式: name=url）
# 用于学习文章系统的代码引用和预览
# 多个仓库会被自动 clone 到 data/repos/ 下
# 例：REPOS=vllm=https://github.com/vllm-project/vllm.git,vllm-assistant=https://github.com/wangxiyuan/vllm-assistant.git
REPOS=

# 代码同步间隔（分钟）(可选，默认: 30)
# 每隔多少分钟拉取一次仓库的最新代码并更新缓存
CODE_SYNC_INTERVAL=30

# ==================== AI 助手配置 ====================

# OpenAI API Key (可选，用于 AI 辅助功能)
# 用于生成 Review 意见、分析影响范围等
OPENAI_API_KEY=sk-your-api-key

# OpenAI API Base URL (可选，默认: https://api.openai.com/v1)
# 如果使用国内代理或其他服务，修改此地址
OPENAI_BASE_URL=https://api.openai.com/v1

# OpenAI 模型名称 (可选，默认: gpt-4o)
OPENAI_MODEL=gpt-4o

# ==================== 服务器配置 ====================

# 监听地址 (可选，默认: 0.0.0.0)
HOST=0.0.0.0

# 监听端口 (可选，默认: 8000)
PORT=8000

# API 密钥 (可选，用于接口鉴权)
API_KEY=

# 调试模式 (可选，默认: false)
# 设为 1、true 或 yes 可开启
DEBUG=

# ==================== 数据清理配置 ====================

# 社区数据保留天数（可选，默认: 90）
# closed/merged 的 issue/PR 超过此天数将被自动清理
DATA_RETENTION_DAYS=90

# AI 缓存保留条数上限（可选，默认: 1000）
# 超过此数量时删除最旧的缓存记录
AI_CACHE_MAX_RECORDS=1000

# 数据清理间隔（小时）(可选，默认: 24)
CLEANUP_INTERVAL=24

# ==================== 调度器配置 ====================

# 数据轮询间隔（分钟）(可选，默认: 10)
POLLING_INTERVAL=10

# 仅同步指定领域（逗号分隔，留空 = 全部）
# 注意：仅大型项目（如 vLLM）需要按领域过滤，一般留空即可
# 例：POLLING_AREAS=engine,hardware
POLLING_AREAS=

# ==================== 学习文章管理系统 ====================

# 文章验证在代码同步时自动执行，无需单独配置

# ==================== Personal TODO 配置 ====================

# 去重检查默认仓库列表（逗号分隔，可选，默认: vllm-project/vllm）
DEFAULT_DEDUP_REPOS=vllm-project/vllm

# 洞察报告异步超时（秒）(可选，默认: 180)
INTELLIGENCE_REPORT_TIMEOUT=180