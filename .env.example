# vLLM Assistant 环境变量配置示例
# 复制此文件为 .env 并填写实际值

# ==================== GitHub 配置 ====================

# GitHub Personal Access Token (必需)
# 用于访问 GitHub API，需要 repo 权限
VLLM_ASSISTANT_PAT=github_pat_your_token_here

# ==================== AI 助手配置 ====================

# OpenAI API Key (可选，用于 AI 辅助功能)
# 用于生成 Review 意见、分析影响范围等
OPENAI_API_KEY=sk-your-api-key

# OpenAI API Base URL (可选，默认: https://api.openai.com/v1)
# 如果使用国内代理或其他服务，修改此地址
OPENAI_BASE_URL=https://maas-coding-api.cn-huabei-1.xf-yun.com/v2

# OpenAI 模型名称 (可选，默认: gpt-4o)
OPENAI_MODEL=astron-code-latest

# LLM 最大 token 数 (可选，默认: 65536)
# 控制 AI 对话的单次最大输出长度
LLM_MAX_TOKENS=65536

# ==================== 服务器配置 ====================

# 监听地址 (可选，默认: 0.0.0.0)
HOST=0.0.0.0

# 监听端口 (可选，默认: 8000)
PORT=8000   

# API 密钥 (可选，用于接口鉴权)
API_KEY=

# 调试模式 (可选，默认: false)
# 设为 1、true 或 yes 可开启
DEBUG=

# ==================== 数据清理配置 ====================

# 社区数据保留天数（可选，默认: 90）
# closed/merged 的 issue/PR 超过此天数将被自动清理
DATA_RETENTION_DAYS=90

# AI 缓存保留条数上限（可选，默认: 1000）
# 超过此数量时删除最旧的缓存记录
AI_CACHE_MAX_RECORDS=1000

# 数据清理间隔（小时）(可选，默认: 24)
CLEANUP_INTERVAL=24

# ==================== 调度器配置 ====================

# 数据轮询间隔（分钟）(可选，默认: 10)
POLLING_INTERVAL=10

# GitHub 同步开关 (可选，默认: true)
# 设为 false 可禁用所有 GitHub API 定时拉取，节省 API 配额（本地调试时推荐）
GITHUB_SYNC_ENABLED=true

# ==================== Personal TODO 配置 ====================

# 洞察报告异步超时（秒）(可选，默认: 180)
INTELLIGENCE_REPORT_TIMEOUT=180

# ==================== Web 搜索配置 ====================

# Tavily 兼容 Web Search API 地址（可选，默认使用公益服务，无需 API Key）
# 默认使用 https://tavily.claude-code-best.win（公益服务，不限制调用量）
# 如果使用官方 Tavily，改为 https://api.tavily.com 并设置 TAVILY_API_KEY
TAVILY_API_URL=https://tavily.claude-code-best.win

# Tavily API Key（可选，官方 Tavily 需要此配置）
# 默认公益服务不需要此配置
TAVILY_API_KEY=

# ==================== Slack 采集配置 ====================
# 凭证通过前端配置页面动态设置
# 邮箱密码用于凭证过期后自动刷新（可选）
SLACK_EMAIL=
SLACK_PASSWORD=

# ==================== NPU 算力管理配置 ====================

# 巡检间隔（秒）(可选，默认: 300)
# 定时 SSH 采集 npu-smi 状态 / 容器镜像 / 模型目录
NPU_CHECK_INTERVAL=300

# 是否写入巡检历史 (可选，默认: true)
# 关闭时只更新机器最新状态，不写利用率曲线数据
NPU_METRICS_ENABLED=true

# 巡检历史保留天数 (可选，默认: 7)
NPU_METRIC_RETENTION_DAYS=7

# 远程任务并发执行线程数 (可选，默认: 2)
NPU_JOB_WORKERS=2

# 一次性任务默认超时（秒）(可选，默认: 3600)
NPU_JOB_TIMEOUT=3600

# 部署健康检查循环超时（秒）(可选，默认: 1800)
NPU_HEALTH_TIMEOUT=1800

# 默认镜像仓库与版本 (可选)
# 机型默认镜像 = repo:version 或 repo:version-机型后缀（-a3 / -310p）
NPU_IMAGE_REPO=quay.io/ascend/vllm-ascend
NPU_IMAGE_VERSION=v0.23.0

# NPU 密码加密密钥 (可选)
# 用于加密存储 NPU 机器的 SSH 密码（auth_type=password 时）
# 未设置时自动生成并持久化到 data/secret_key（权限 600）
NPU_SECRET_KEY=